# OpenAI-compatible LLM settings (optional — mock used if OPENAI_API_KEY unset)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Tip: in the desk UI, paste key+base URL → Fetch models → pick from dropdown (also topbar model picker).

# App
DATABASE_URL=sqlite:///./grok_org_os.db
HOST=0.0.0.0
PORT=8000
WORKSPACE_DIR=workspace

# Connectors (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WEBHOOK_URL=
REST_BASE_URL=
REST_API_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
